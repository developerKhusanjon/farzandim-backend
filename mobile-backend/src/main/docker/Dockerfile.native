# Native tasvir — ~50 MB, ishga tushish ~0.02 s, RAM ~64 MB.
# DigitalOcean'dagi kichik Droplet uchun aynan shu kerak.
#
# Build:
#   ./mvnw package -Dnative -pl mobile-backend
#   docker build -f mobile-backend/src/main/docker/Dockerfile.native -t farzandim/mobile-backend mobile-backend
FROM registry.access.redhat.com/ubi9/ubi-minimal:latest

WORKDIR /work/
RUN chown 1001 /work && chmod "g+rwX" /work && chown 1001:root /work
COPY --chown=1001:root --chmod=0755 target/*-runner /work/application

EXPOSE 8082
USER 1001

ENTRYPOINT ["./application", "-Dquarkus.http.host=0.0.0.0"]
