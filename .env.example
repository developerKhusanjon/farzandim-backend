# =============================================================================
# Farzandim AI — backend muhit o'zgaruvchilari
#
# Lokal uchun: `cp .env.example .env` va docker-compose'ni ishga tushiring.
# Produksiyada bu qiymatlar DigitalOcean App Platform secrets yoki
# Droplet'dagi systemd EnvironmentFile orqali beriladi. Hech qachon git'ga
# kirmaydi.
# =============================================================================

# --- docker-compose host portlari --------------------------------------------
# Mashinada 5432/6379 band bo'lsa (boshqa loyiha) — shu yerda o'zgartiring.
POSTGRES_PORT=5432
VALKEY_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- PostgreSQL (DigitalOcean Managed) ---------------------------------------
# stringtype=unspecified — jsonb ustunlar uchun majburiy
# Produksiyada: ?sslmode=require&stringtype=unspecified
DB_URL=jdbc:postgresql://localhost:5432/farzandim?stringtype=unspecified
#
# Har servis O'Z roli bilan ulanadi — DB_USER / DB_PASSWORD har servis
# konteyneriga alohida beriladi (bitta umumiy qiymat emas):
#   school-backend  DB_USER=farzandim_school  DB_PASSWORD=...
#   mobile-backend  DB_USER=farzandim_mobile  DB_PASSWORD=...
#   admin-backend   DB_USER=farzandim_admin   DB_PASSWORD=...
# Dev'da kerak emas: rollar V902 dev seed'ida yaratiladi, parollar %dev da.
# Production'da DB_PASSWORD'ning standart qiymati yo'q — berilmasa servis
# ishga tushmaydi. Rollarni yaratish: scripts/db-roles.sh (bir marta).
#
# Hovuz (standart: school 8, mobile 8, admin 3 — jami 22 ulanish byudjetiga sig'adi)
# DB_POOL_MAX=8
#
# PgBouncer / DigitalOcean Connection Pools orqali (transaction rejimi) —
# pool porti 25061 va `prepareThreshold=0` SHART:
# DB_URL=jdbc:postgresql://host:25061/farzandim-pool?sslmode=require&stringtype=unspecified&prepareThreshold=0

# --- Migratsiya (alohida deploy qadami: scripts/migrate.sh) -------------------
# Sxema egasi — DDL huquqi faqat shunda. Pool orqali EMAS, to'g'ridan-to'g'ri
# (25060-port). Servislar faqat tekshiradi (FLYWAY_VALIDATE=true).
# DB_MIGRATION_USER=farzandim_owner
# DB_MIGRATION_PASSWORD=

# --- Valkey (kesh, rate limit, lock) -----------------------------------------
VALKEY_URL=redis://localhost:6379
# Produksiyada: rediss://default:<parol>@<host>:25061

# --- JWT ----------------------------------------------------------------------
# Lokalda dev-keys/ ichidagi kalitlar ishlatiladi. Produksiyada — secret fayl.
JWT_ISSUER=https://api.farzandim.uz
# JWT_PRIVATE_KEY_LOCATION=/run/secrets/jwt-private.pem
# JWT_PUBLIC_KEY_LOCATION=/run/secrets/jwt-public.pem
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# --- DigitalOcean Spaces ------------------------------------------------------
# Bucket PRIVATE bo'lishi shart. Ruxsatni backend beradi (presigned URL).
SPACES_ENABLED=false
SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com
SPACES_BUCKET=farzandim-dev
SPACES_REGION=fra1
SPACES_KEY=
SPACES_SECRET=
# Lokal MinIO bilan sinash uchun:
# SPACES_ENABLED=true
# SPACES_ENDPOINT=http://localhost:9000
# SPACES_REGION=us-east-1
# SPACES_KEY=farzandim
# SPACES_SECRET=farzandim-secret

# --- AI (Anthropic) -----------------------------------------------------------
AI_ENABLED=false
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
AI_DEEP_MODEL=claude-opus-5
# AI job worker va fon tozalash ishlari faqat school-backend'da yoqiladi
AI_WORKER=true
MAINTENANCE=true

# --- Embedding (semantik qidiruv, ixtiyoriy) ----------------------------------
# O'lcham migratsiyadagi vector(1024) bilan mos bo'lishi shart
EMBEDDING_ENABLED=false
VOYAGE_API_KEY=

# --- SMS shlyuzi (O'zbekiston) ------------------------------------------------
# log        — hech narsa yubormaydi, matnni logga yozadi (dev)
# eskiz      — eskiz.uz, shaxsiy kabinetdan email/parol
# playmobile — playmobile.uz (smsxabar broker API)
SMS_PROVIDER=log
# Jo'natuvchi nomi — operator tasdiqlagan qisqa raqam yoki alfanumerik nom
SMS_FROM=4546
SMS_DAILY_LIMIT=20
# Login/parolni SMS bilan yuborish (standart: yo'q — maktab qog'ozda beradi)
SMS_SEND_CREDENTIALS=false
# Yetkazib berish hisoboti: https://api.farzandim.uz/api/v1/webhooks/sms/eskiz?token=...
SMS_CALLBACK_URL=
SMS_CALLBACK_TOKEN=

ESKIZ_EMAIL=
ESKIZ_PASSWORD=
# PLAYMOBILE_LOGIN=
# PLAYMOBILE_PASSWORD=

# --- Push (Firebase Cloud Messaging HTTP v1) ----------------------------------
# log — logga yozadi (dev) · fcm — haqiqiy yuborish
PUSH_PROVIDER=log
# Variant 1: service account JSON fayli (Droplet secret)
FCM_CREDENTIALS_FILE=
# Variant 2: alohida o'zgaruvchilar (App Platform secrets uchun qulay)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# PKCS#8 PEM. Bir qatorda `\n` bilan bo'lishi mumkin — kod uni o'zi ajratadi.
FCM_PRIVATE_KEY=
# Android bildirishnoma kanali — Expo/RN tomonidagi kanal id bilan bir xil bo'lsin
FCM_ANDROID_CHANNEL=farzandim-default

# --- Email --------------------------------------------------------------------
# log — konsolga chiqaradi (dev) · smtp — haqiqiy yuborish
EMAIL_PROVIDER=log
EMAIL_FROM=Farzandim AI <no-reply@farzandim.uz>
EMAIL_REPLY_TO=
EMAIL_DAILY_LIMIT=30

# SMTP (masalan Zoho, Yandex 360, SendGrid, Amazon SES)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_START_TLS=REQUIRED
# Produksiyada false — aks holda xat jo'natilmaydi, faqat konsolga chiqadi
MAIL_MOCK=true

# --- CORS ---------------------------------------------------------------------
# 5180 — web CRM, 5190 — super admin paneli (farzandim-admin)
CORS_ORIGINS=http://localhost:5180,http://localhost:5173,http://localhost:5190

# --- Proksi (admin-backend audit jurnali uchun haqiqiy IP) --------------------
# Faqat ishonchli proksi ortida (App Platform, nginx) true qiling — aks holda
# X-Forwarded-For'ni istalgan mijoz soxtalashtiradi.
HTTP_PROXY_FORWARDING=false
# HTTP_TRUSTED_PROXIES=10.0.0.0/8

# --- Log ----------------------------------------------------------------------
LOG_LEVEL=DEBUG
